{
  "info": {
    "_postman_id": "bde6fd55-4d8e-49a2-9f27-2ef8826ef146",
    "name": "AlgoTech Hub - Microservices",
    "description": "Collection de test pour AlgoTech Hub.\n\nUsage rapide:\n1) Importer la collection\n2) Mettre la variable baseUrl:\n   - Local: http://localhost:8080\n   - Docker: http://localhost:8888\n3) Lancer les requetes dans l'ordre des dossiers.\n\nLes IDs (trainerId, memberId, eventId, bookingId) sont captures automatiquement.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 - Verification",
      "item": [
        {
          "name": "Discovery - UI",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{discoveryUrl}}/"
          }
        },
        {
          "name": "Gateway - Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/health"
          }
        }
      ]
    },
    {
      "name": "1 - Members",
      "item": [
        {
          "name": "Create Trainer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('trainerEmail', 'trainer+' + Date.now() + '@algotech.local');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json && json.id) {",
                  "  pm.collectionVariables.set('trainerId', String(json.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Jean\",\n  \"lastName\": \"Formateur\",\n  \"email\": \"{{trainerEmail}}\",\n  \"role\": \"TRAINER\",\n  \"skills\": \"Spring Boot, Java\"\n}"
            },
            "url": "{{baseUrl}}/api/members"
          }
        },
        {
          "name": "Create Student",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('studentEmail', 'student+' + Date.now() + '@algotech.local');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json && json.id) {",
                  "  pm.collectionVariables.set('memberId', String(json.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Regent\",\n  \"lastName\": \"Jauress\",\n  \"email\": \"{{studentEmail}}\",\n  \"role\": \"STUDENT\",\n  \"skills\": \"Docker, API Testing\"\n}"
            },
            "url": "{{baseUrl}}/api/members"
          }
        },
        {
          "name": "Get All Members",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/members"
          }
        },
        {
          "name": "Get Member By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/members/{{memberId}}"
          }
        }
      ]
    },
    {
      "name": "2 - Events",
      "item": [
        {
          "name": "Create Event",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
