                  "if (json && json.id) {",
                  "  pm.collectionVariables.set('eventId', String(json.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Atelier Spring Microservices\",\n  \"description\": \"Session pratique sur Eureka, Gateway et Feign\",\n  \"eventDate\": \"2099-12-31T10:00:00\",\n  \"location\": \"Lab A\",\n  \"trainerId\": {{trainerId}},\n  \"maxCapacity\": 30\n}"
            },
            "url": "{{baseUrl}}/api/events"
          }
        },
        {
          "name": "Get All Events",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/events"
          }
        },
        {
          "name": "Get Event By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/events/{{eventId}}"
          }
        }
      ]
    },
    {
      "name": "3 - Bookings",
      "item": [
        {
          "name": "Create Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json && json.id) {",
                  "  pm.collectionVariables.set('bookingId', String(json.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"memberId\": {{memberId}},\n  \"eventId\": {{eventId}}\n}"
            },
            "url": "{{baseUrl}}/api/bookings"
          }
        },
        {
          "name": "Get Bookings By Member",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/bookings/member/{{memberId}}"
          }
        }
      ]
    }
  ],
